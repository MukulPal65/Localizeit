# ============================================================
# LocalizeIt — environment template
# Copy to .env and fill values when real integrations land.
# Set VITE_DEMO_MODE=true only for local demonstrations.
# ============================================================

# ── App ─────────────────────────────────────────────────────
VITE_APP_NAME=LocalizeIt
VITE_APP_ENV=development
VITE_DEMO_MODE=true

# ── Supabase (future backend) ───────────────────────────────
VITE_SUPABASE_URL=https://ddzxfbgojrjynoqnjmya.supabase.co 
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (Razorpay — demo only) ─────────────────────────
VITE_RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_SECRET=

# ── AI providers (use one; keep keys server-side in production) ─
VITE_AI_PROVIDER=groq
VITE_AI_API_KEY=
VITE_AI_BASE_URL=
VITE_AI_MODEL=
VITE_GROQ_API_KEY=
VITE_HUGGINGFACE_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_GEMINI_API_KEY=

# ── Maps / geocoding ────────────────────────────────────────
VITE_MAPS_API_KEY=
VITE_GEOCODING_API_KEY=
VITE_OPENROUTESERVICE_API_KEY=

# ── Notifications (OTP / alerts) ────────────────────────────
VITE_SMS_API_KEY=
VITE_WHATSAPP_API_KEY=

# ── Demo fee config (UI-editable in Admin > Fees) ───────────
VITE_PLATFORM_FEE=30
VITE_PLATFORM_FEE_THRESHOLD=500
VITE_DELIVERY_FEE_NEAR=30
VITE_DELIVERY_FEE_FAR=50
